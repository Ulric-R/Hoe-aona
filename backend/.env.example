# Copiez ce fichier en .env puis renseignez les clés gratuites dont vous disposez.
# L'application fonctionne sans clé, en mode dégradé (Wikipedia, GDELT, Banque mondiale restent actifs).

# LLM compatibles OpenAI (au moins un recommandé)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=              # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
LLM_PRIORITY=gemini,groq

# Sources de preuves
GOOGLE_FACTCHECK_API_KEY=  # https://console.cloud.google.com (activer « Fact Check Tools API »)
TAVILY_API_KEY=            # https://app.tavily.com
# Détection IA image et OCR de secours
SIGHTENGINE_API_USER=      # https://sightengine.com
SIGHTENGINE_API_SECRET=
OCR_SPACE_API_KEY=         # https://ocr.space/ocrapi

# MCP : "mcp" (outils appelés via le serveur MCP) ou "direct"
MCP_MODE=mcp
CORS_ORIGINS=["http://localhost:4200"]
